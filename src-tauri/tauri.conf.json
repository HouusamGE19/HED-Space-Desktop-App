{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HED Space",
  "version": "0.6.43",
  "identifier": "space.hed.desktop",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HED Space",
        "width": 1600,
        "height": 1000,
        "minWidth": 980,
        "minHeight": 650,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#050506",
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob:; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": [
      "bin/"
    ],
    "copyright": "Copyright \u00a9 2026 Houssam Elmouqaddam. All rights reserved."
  }
}
